.result__column { width: 1000px; max-width: 96%; align-items: center; }

.result__headline { font-size: 150px; margin-bottom: 30px; }

.result__stars { flex-direction: row; justify-content: center; align-items: center; height: 200px; margin-bottom: 6px; }
/* the three result stars are big, and pop in one after the other */
.result__stars .star {
    width: 170px; height: 170px; margin: 0 14px;
    scale: 0.4 0.4; opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}
.result__stars .star.is-in { scale: 1 1; opacity: 1; }
.result__stars .star--slot1 { transition-delay: 0.1s; }
.result__stars .star--slot2 { transition-delay: 0.25s; }
.result__stars .star--slot3 { transition-delay: 0.4s; }
.result__stars .star--slot2.is-in { translate: 0 -18px; }

.result__best { font-size: 48px; color: var(--clay); min-height: 60px; }
.result__score { font-size: 80px; margin: 8px 0 18px 0; }

.result__goals { align-items: center; align-self: stretch; margin-bottom: 20px; }
.result__goal { font-size: 46px; color: var(--slate); -unity-text-align: middle-center; white-space: normal; padding: 4px 0; }

.result__buttons { flex-direction: row; justify-content: center; margin-top: 24px; }
.result__buttons .pebble-button { width: 420px; }

.layout--tall .result__headline { font-size: 130px; }
.layout--tall .result__buttons { flex-direction: column; align-items: center; }
.layout--tall .result__buttons .pebble-button { width: 620px; height: 150px; }
.layout--tall .result__stars .star { width: 150px; height: 150px; margin: 0 8px; }

.layout--wide .result__column { width: 1500px; }
.layout--wide .result__headline { font-size: 130px; margin-bottom: 14px; }
.layout--wide .result__stars { height: 170px; }
.layout--wide .result__stars .star { width: 140px; height: 140px; }
.layout--wide .result__score { font-size: 70px; }
.layout--wide .result__buttons .pebble-button { width: 400px; height: 124px; font-size: 52px; }
