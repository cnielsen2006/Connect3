/* Shared look of every screen, style K: Pebbles (docs/art/STYLE-K-Pebbles.md sections 2 and 6).
   Colors are custom properties on the shell root: change them here, nowhere else.
   Sizes are in panel units (the panel scales with the screen: reference 1080x1920, so a phone in portrait is ~1080 wide). */

.shell {
    --ink: rgb(79, 74, 70);
    --slate: rgb(123, 135, 148);
    --clay: rgb(185, 132, 104);
    --clay-dark: rgb(150, 104, 80);
    --sage: rgb(143, 160, 138);
    --sage-dark: rgb(103, 118, 99);
    --sand: rgb(205, 180, 141);
    --sand-pale: rgb(231, 222, 204);
    --sand-dark: rgb(190, 163, 124);
    --driftwood: rgb(201, 180, 143);
    --locked: rgb(214, 204, 186);
    --star-off: rgb(196, 182, 156);
    --on-dark: rgb(250, 247, 240);
    --scrim: rgba(239, 232, 219, 0.93);
    --paper: rgba(250, 246, 238, 0.86);

    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-font: url("project:/Assets/Cascade/UI/Fonts/Delius-Regular.ttf");
    color: var(--ink);
    font-size: 44px;
}

/* The safe area: UiRoot sets left/top/right/bottom on this element, so every screen is laid out inside the cutouts and system bars. */
.safe { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

/* ---- screens and overlays: hidden until UiRoot shows them, then faded in and out ---- */

.screen, .overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-in-out;
}
.screen--shown, .overlay--shown { opacity: 1; }

.screen-fill {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.display-title {
    -unity-font: url("project:/Assets/Cascade/UI/Fonts/DeliusSwashCaps-Regular.ttf");
    color: var(--clay);
    -unity-text-align: middle-center;
    white-space: normal;
}

.rule {
    height: 3px;
    align-self: stretch;
    background-color: var(--driftwood);
}

/* ---- pebble buttons: a flat stone resting on the sand, darker lower edge ---- */

.pebble-button {
    width: 460px; height: 132px;
    margin: 12px 14px;
    padding: 0;
    border-width: 0 0 10px 0;
    border-radius: 50%;
    font-size: 52px;
    -unity-text-align: middle-center;
    -unity-font: url("project:/Assets/Cascade/UI/Fonts/Delius-Regular.ttf");
    transition-property: scale;
    transition-duration: 0.12s;
}
.pebble-button--small { width: 270px; height: 112px; font-size: 46px; }
.pebble-button--tiny { width: 200px; height: 90px; font-size: 38px; margin: 6px; }

.pebble-button--sage, .pebble-button--sage:hover, .pebble-button--sage:active, .pebble-button--sage:focus {
    background-color: var(--sage);
    border-color: var(--sage-dark);
    color: var(--on-dark);
}
.pebble-button--sand, .pebble-button--sand:hover, .pebble-button--sand:active, .pebble-button--sand:focus {
    background-color: var(--sand-pale);
    border-color: var(--sand);
    color: var(--ink);
}
.pebble-button--clay, .pebble-button--clay:hover, .pebble-button--clay:active, .pebble-button--clay:focus {
    background-color: var(--clay);
    border-color: var(--clay-dark);
    color: var(--on-dark);
}
.pebble-button:hover { scale: 1.04 1.04; }
.pebble-button:active { scale: 0.97 0.97; border-bottom-width: 5px; }
.pebble-button:disabled { opacity: 0.45; }

/* ---- stars: drawn by StarElement in the element's text color ---- */

.star { width: 64px; height: 64px; color: var(--star-off); margin: 0 4px; }
.star--earned { color: var(--clay); }
.star--small { width: 40px; height: 40px; margin: 0 1px; }

/* ---- screen header (map, settings) ---- */

.header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    justify-content: space-between;
    padding: 18px 24px 8px 24px;
}
.header__title { font-size: 84px; flex-grow: 1; -unity-text-align: middle-center; }
.header__side { width: 300px; align-items: flex-start; }
.header__side--right { align-items: flex-end; }
.header .pebble-button { margin: 0; }

/* ---- skins: the other art styles re-colour the same roles (docs/art/STYLE-I-Claymation.md, STYLE-J-StudioSet.md section 2/6) ----
   UiRoot.SetSkin adds skin-i or skin-j to the shell. K (no class) is the default above. Role mapping:
   --clay = accent/title, --sage = Pause button, --sand = Hint button, --slate = secondary, --sand-pale = cards, --ink = text. */

.shell.skin-i {
    --ink: rgb(59, 45, 36);
    --slate: rgb(93, 122, 140);
    --clay: rgb(184, 97, 63);
    --clay-dark: rgb(122, 61, 38);
    --sage: rgb(107, 125, 70);
    --sage-dark: rgb(63, 74, 40);
    --sand: rgb(233, 220, 198);
    --sand-pale: rgb(233, 220, 198);
    --sand-dark: rgb(168, 144, 111);
    --driftwood: rgb(201, 184, 156);
    --locked: rgb(201, 184, 156);
    --star-off: rgb(168, 151, 122);
    --on-dark: rgb(250, 244, 232);
    --scrim: rgba(227, 214, 191, 0.94);
    --paper: rgba(233, 220, 198, 0.9);
    -unity-font: url("project:/Assets/Cascade/UI/Fonts/ShantellSans-Regular.ttf");
}
.skin-i .display-title, .skin-i .popup, .skin-i .combo-badge, .skin-i .pebble-button, .skin-i .dev__title {
    -unity-font: url("project:/Assets/Cascade/UI/Fonts/ShantellSans-Regular.ttf");
}
.skin-i .popup { color: rgb(122, 61, 38); }
.skin-i .combo-badge { color: rgb(184, 97, 63); }

.shell.skin-j {
    --ink: rgb(239, 230, 214);
    --slate: rgb(63, 122, 120);
    --clay: rgb(201, 162, 39);
    --clay-dark: rgb(154, 123, 24);
    --sage: rgb(63, 122, 120);
    --sage-dark: rgb(40, 84, 82);
    --sand: rgb(122, 122, 58);
    --sand-pale: rgb(74, 58, 48);
    --sand-dark: rgb(84, 84, 38);
    --driftwood: rgb(122, 96, 72);
    --locked: rgb(70, 56, 48);
    --star-off: rgb(98, 82, 68);
    --on-dark: rgb(250, 244, 232);
    --scrim: rgba(24, 18, 15, 0.93);
    --paper: rgba(46, 36, 30, 0.9);
    -unity-font: url("project:/Assets/Cascade/UI/Fonts/PatrickHand-Regular.ttf");
}
.skin-j .display-title, .skin-j .popup, .skin-j .combo-badge, .skin-j .dev__title {
    -unity-font: url("project:/Assets/Cascade/UI/Fonts/PatrickHandSC-Regular.ttf");
}
.skin-j .pebble-button { -unity-font: url("project:/Assets/Cascade/UI/Fonts/PatrickHand-Regular.ttf"); }
.skin-j .popup { color: rgb(242, 217, 120); }
.skin-j .combo-badge { color: rgb(201, 162, 39); }
